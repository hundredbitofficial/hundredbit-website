# Public site details (baked in at build time: set these BEFORE `npm run build`)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=            # digits only with country code, e.g. 919876543210
NEXT_PUBLIC_LOCATION=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_GITHUB_URL=
# The enquiry email address is NOT set here. Edit TO_EMAIL in public/api/contact.php
