<?php
declare(strict_types=1);

/* ============ EDIT THESE TWO LINES ============ */
const TO_EMAIL   = 'undredbit.official@gmail.com';       // the inbox that receives enquiries
const FROM_EMAIL = 'no-reply@yourdomain.com';  // an address on YOUR domain (helps avoid spam folders)
/* ============================================== */

header('Content-Type: application/json; charset=utf-8');
header('Cache-Control: no-store');

function respond(int $code, array $data): void { http_response_code($code); echo json_encode($data); exit; }
function one_line(mixed $v, int $max): string {
    $v = preg_replace('/[\x00-\x1F\x7F]+/u', ' ', (string)$v) ?? '';
    return mb_substr(trim($v), 0, $max);
}
function multi_line(mixed $v, int $max): string {
    $v = preg_replace('/[^\P{C}\n]+/u', '', str_replace("\r", '', (string)$v)) ?? '';
    return mb_substr(trim($v), 0, $max);
}

if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') respond(405, ['error' => 'Method not allowed.']);

// Same-origin only
$origin = $_SERVER['HTTP_ORIGIN'] ?? '';
if ($origin !== '') {
    $oh = parse_url($origin, PHP_URL_HOST);
    $hh = explode(':', $_SERVER['HTTP_HOST'] ?? '')[0];
    if ($oh !== $hh) respond(403, ['error' => 'Forbidden.']);
}

if (str_contains(TO_EMAIL, 'yourdomain.com')) {
    respond(500, ['error' => 'The enquiry email address has not been configured yet.']);
}

// Rate limit: 5 enquiries / 10 minutes per IP
$ip = $_SERVER['REMOTE_ADDR'] ?? 'unknown';
$rl = sys_get_temp_dir() . '/hb_rl_' . md5($ip) . '.json';
$now = time(); $hits = [];
if (is_file($rl)) { $hits = array_values(array_filter(json_decode((string)file_get_contents($rl), true) ?: [], fn($t) => $now - (int)$t < 600)); }
if (count($hits) >= 5) respond(429, ['error' => 'Too many enquiries. Please try again in a few minutes.']);
$hits[] = $now; @file_put_contents($rl, json_encode($hits), LOCK_EX);

// Read JSON or form data
$raw = file_get_contents('php://input');
$in = json_decode($raw ?: '', true);
if (!is_array($in)) $in = $_POST;

if (!empty($in['website'])) respond(200, ['ok' => true]);                       // honeypot: pretend success
if (isset($in['elapsed']) && (int)$in['elapsed'] < 2500) respond(400, ['error' => 'Please take a moment to complete the form.']);

$name = one_line($in['name'] ?? '', 120);
$email = one_line($in['email'] ?? '', 160);
$phone = one_line($in['phone'] ?? '', 30);
$company = one_line($in['company'] ?? '', 160);
$service = one_line($in['service'] ?? '', 80);
$budget = one_line($in['budget'] ?? '', 60);
$timeline = one_line($in['timeline'] ?? '', 60);
$message = multi_line($in['message'] ?? '', 4000);

if ($name === '' || !filter_var($email, FILTER_VALIDATE_EMAIL) || $service === '' || mb_strlen($message) < 10) {
    respond(400, ['error' => 'Please check the required fields.']);
}

$subject = mb_encode_mimeheader("New enquiry: $service - $name", 'UTF-8', 'B');
$body = "You have a new project enquiry from the Hundred Bit website.\n\n"
      . "Name:     $name\nEmail:    $email\nPhone:    " . ($phone ?: '-') . "\nCompany:  " . ($company ?: '-') . "\n"
      . "Service:  $service\nBudget:   " . ($budget ?: '-') . "\nTimeline: " . ($timeline ?: '-') . "\n\n"
      . "Project description:\n$message\n\n---\nSent from the website contact form. Reply to this email to answer the visitor directly.\n";

$fromName = mb_encode_mimeheader('Hundred Bit Website', 'UTF-8', 'B');
$headers = [
    "From: $fromName <" . FROM_EMAIL . ">",
    "Reply-To: $email",
    'MIME-Version: 1.0',
    'Content-Type: text/plain; charset=UTF-8',
    'X-Mailer: PHP/' . phpversion(),
];
$sent = @mail(TO_EMAIL, $subject, $body, implode("\r\n", $headers), '-f' . FROM_EMAIL);
if (!$sent) $sent = @mail(TO_EMAIL, $subject, $body, implode("\r\n", $headers));

if (!$sent) respond(502, ['error' => 'We could not send your enquiry right now.']);
respond(200, ['ok' => true]);
